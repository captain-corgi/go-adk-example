# OpenAI-compatible model configuration.
# Copy this file to .env and fill in your values:
#   cp .env.example .env        (POSIX)
#   copy .env.example .env      (Windows cmd)

# API key. Required for api.openai.com; leave blank if your compatible
# endpoint (below) does not require one.
OPENAI_API_KEY=

# Base URL of an OpenAI Responses-API-compatible server. Leave blank for
# api.openai.com. Common compatible endpoints:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
OPENAI_BASE_URL=

# Model name to serve. Falls back to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini
