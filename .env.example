# OpenAI-compatible model configuration.
# Copy this file to .env and fill in your values:
#   cp .env.example .env        (POSIX)
#   copy .env.example .env      (Windows cmd)

# API key. Required for api.openai.com; leave blank if your compatible
# endpoint (below) does not require one.
OPENAI_API_KEY=

# Base URL of an OpenAI Responses-API-compatible server. Leave blank for
# api.openai.com. Common compatible endpoints:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
OPENAI_BASE_URL=

# Model name. Falls back to gpt-5.6-sol (the config default) when unset; also
# serves as the fallback for MODEL_STRONG / MODEL_CHEAP below.
OPENAI_MODEL=

# --- Marketing Engine (Phase 0) ---
# Strong + cheap model aliases. Each falls back to OPENAI_MODEL when unset
# (Phase 0: one model, two aliases).
MODEL_STRONG=
MODEL_CHEAP=
# Bypass the human sign-off gate (CI / non-interactive runs).
AUTO_APPROVE=false
# Max drafter→checker iterations per deliverable before shipping best draft.
MAX_LOOP_ITER=3
# Directory of frozen brand Markdown files (voice.md, offers.md, icp.md, ...).
GBRAIN_DIR=./brand
